<?xml version="1.0" encoding="utf-8"?>
<!--
  UNIQUE probe application.

  Deliberately ordinary: a plain Application subclass, one Activity, SharedPreferences, a
  file and a SQLite database. Nothing about it knows it is being virtualized, which is the
  point - it reports what the platform tells it, and the verification suite checks those
  answers against what UNIQUE intended.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unique.probe"
    android:versionCode="40"
    android:versionName="1.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Runtime permissions the probe asks about. CAMERA is the one the suite drives;
         RECORD_AUDIO is declared and never requested, so "declared but not granted"
         is distinguishable from "never mentioned". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name="com.unique.probe.ProbeApplication"
        android:label="@string/app_name"
        android:allowBackup="false">

        <!--
          Meta-data in both shapes an app uses, because they fail differently.

          `@integer/probe_number` is a *reference*: the platform resolves it against this
          app's resources before putting an int in `ApplicationInfo.metaData`, which is
          exactly what `com.google.android.gms.version` is and exactly what Google Play
          services throws on when it is missing. A literal string cannot detect that bug.
        -->
        <meta-data android:name="com.unique.probe.number"
            android:value="@integer/probe_number" />
        <meta-data android:name="com.unique.probe.text" android:value="probe-meta" />

        <activity
            android:name="com.unique.probe.ProbeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Phase 3 targets. The Activity does not touch them, so the phase 2
             acceptance path is unaffected until the tests exercise them. -->
        <service
            android:name="com.unique.probe.ProbeService"
            android:exported="false" android:foregroundServiceType="dataSync">
            <!--
              Reachable by action, which is how a great many SDKs reach their own worker:
              the action is a constant they own and the resolution never leaves their
              package. Under virtualization there is no installed package to resolve
              against, so this filter is what UNIQUE has to answer from.
            -->
            <intent-filter>
                <action android:name="com.unique.probe.START_BY_ACTION" />
            </intent-filter>
        </service>

        <!--
          Declares an orientation, which is the point of it.

          The platform decides a window's orientation from the manifest entry it has
          *installed*, which under UNIQUE is a stub declaring `unspecified`. So this is the
          only way to test that a landscape app opens landscape - the fault a tester
          reported as "игры запускаются вертикально".
        -->
        <activity
            android:name="com.unique.probe.ProbeSecondActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:launchMode="standard" />

        <!-- Reachable only by matching an intent against these filters. A custom action
             the device has no other handler for, and the app's own URI scheme - which is
             the shape a browser uses to hand an OAuth result back. -->
        <activity
            android:name="com.unique.probe.ProbeDeepLinkActivity"
            android:exported="false"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="com.unique.probe.CUSTOM_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="unique-probe" android:host="open" />
            </intent-filter>
            <!-- So the share test has somewhere to land without a chooser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name="com.unique.probe.ProbeJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name="com.unique.probe.ProbeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.unique.probe.PING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="com.unique.probe.ProbeProvider"
            android:authorities="com.unique.probe.provider"
            android:exported="false" />

        <!-- Same class of thing, in a second process. An ordinary app shape, and the one
             that needs a query to cross a process boundary. -->
        <provider
            android:name="com.unique.probe.ProbeAltProvider"
            android:authorities="com.unique.probe.altprovider"
            android:process=":alt"
            android:exported="false" />

    </application>
</manifest>
