<?xml version="1.0" encoding="utf-8"?>
<!--
  UNIQUE probe application.

  Deliberately ordinary: a plain Application subclass, one Activity, SharedPreferences, a
  file and a SQLite database. Nothing about it knows it is being virtualized, which is the
  point - it reports what the platform tells it, and the verification suite checks those
  answers against what UNIQUE intended.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.unique.probe"
    android:versionCode="18"
    android:versionName="1.0.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Runtime permissions the probe asks about. CAMERA is the one the suite drives;
         RECORD_AUDIO is declared and never requested, so "declared but not granted"
         is distinguishable from "never mentioned". -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name="com.unique.probe.ProbeApplication"
        android:label="UNIQUE Probe"
        android:allowBackup="false">

        <activity
            android:name="com.unique.probe.ProbeActivity"
            android:exported="true"
            android:label="UNIQUE Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Phase 3 targets. The Activity does not touch them, so the phase 2
             acceptance path is unaffected until the tests exercise them. -->
        <service
            android:name="com.unique.probe.ProbeService"
            android:exported="false" />

        <activity
            android:name="com.unique.probe.ProbeSecondActivity"
            android:exported="false"
            android:launchMode="standard" />

        <receiver
            android:name="com.unique.probe.ProbeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.unique.probe.PING" />
            </intent-filter>
        </receiver>

        <provider
            android:name="com.unique.probe.ProbeProvider"
            android:authorities="com.unique.probe.provider"
            android:exported="false" />

    </application>
</manifest>
