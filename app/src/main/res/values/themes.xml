<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base host theme. Near-black ground with edge-to-edge windows, matching the Flutter
      UI so there is no flash of a differently coloured system window during startup.
    -->
    <style name="Theme.Unique" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/unique_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
      Splash. Black ground plus the UNIQUE mark, shown only until Flutter's first frame.
      Deliberately not animated: an animated splash is time the user waits for nothing.
    -->
    <style name="Theme.Unique.Splash" parent="Theme.Unique">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!--
      Stub activity theme.

      Opaque, and deliberately so. The window is created by the system from the *stub's*
      manifest attributes before any UNIQUE code runs in the target process; the virtual
      activity's own theme is applied client-side afterwards. A translucent stub therefore
      makes an ordinary opaque app render see-through, which is far worse than the brief
      flash a translucent stub was meant to avoid.

      DeviceDefault rather than Material: it is what an app with no theme of its own gets
      on the device, so the fallback matches the platform instead of matching UNIQUE.
    -->
    <style name="Theme.Unique.Stub" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!--
          No overrides, and that is the change.

          This theme used to set `windowAnimationStyle` to @null and `windowDisablePreview`
          to true. Neither was ever explained, and both were almost certainly meant to hide
          a stub window from the user - except there is no stub window to hide. The launch
          transaction is rewritten before `performLaunchActivity` constructs anything, so
          the window the system creates from this theme *is* the guest's window. Suppressing
          its animation and its starting window suppresses the guest's.

          Together they produce exactly what a device tester reported as "the screen is
          laggy": tap, nothing at all appears - no starting window, because previews are
          off - then the content snaps in with no transition, after however long a JIT-only
          cold start takes. Nothing is dropping frames; the log for that run contains a
          single skipped-frame event in 37,775 lines. It is a launch with the two things
          that normally cover a launch turned off.

          So the platform's own behaviour is restored: a starting window appears
          immediately, drawn from DeviceDefault, which is what an app with no theme of its
          own gets on this device; and activities animate like every other app's.

          The residual cost is honest and small: the starting window is UNIQUE's neutral
          background rather than the guest's own splash colour, because the system draws it
          from this manifest entry before the guest's process exists. A brief neutral frame
          is better than a frozen one.
        -->
    </style>
</resources>
