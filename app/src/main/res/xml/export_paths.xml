<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the device through the share sheet.

  Exactly one directory: the diagnostics packages UNIQUE writes itself. Nothing under an
  instance's data directory is reachable through this provider, which is a structural
  guarantee rather than a rule someone has to remember - a path that is not listed here
  cannot be granted, whatever a URI says.
-->
<paths>
    <cache-path name="diagnostics" path="diagnostics/" />
</paths>
