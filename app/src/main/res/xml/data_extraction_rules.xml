<?xml version="1.0" encoding="utf-8"?>
<!--
  Virtual app data never leaves the device through backup.

  It contains other applications' credentials and databases, and a cloud backup of that
  is a liability neither UNIQUE nor its users want. Export happens only through the
  explicit, user-initiated instance export described in ARCHITECTURE.md section 39.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
