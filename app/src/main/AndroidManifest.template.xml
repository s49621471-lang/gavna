<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for UNIQUE's host manifest.

  The stub component pool is injected at the GENERATED_STUBS marker by
  :app:generateStubs. Edit this file, never build/generated/unique/manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact alarms.

      A virtual app's alarm is scheduled by UNIQUE, so the host's permission is what the
      platform checks. SCHEDULE_EXACT_ALARM is user-grantable ("Alarms & reminders") and
      is the one an ordinary app would hold; USE_EXACT_ALARM is deliberately not declared,
      because it is reserved for alarm-clock and calendar apps and Play requires a policy
      declaration for it.

      When the user revokes it, a guest asking for an exact alarm gets the same
      SecurityException it would get on a device where its own permission was revoked.
      That is faithful, and UNIQUE reports it rather than silently downgrading the alarm
      to inexact - an alarm that fires ten minutes late is worse than one that visibly
      fails.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Foreground service types.

      A virtual app's foreground service runs on one of UNIQUE's stub services, so the
      host must declare every type it is willing to forward and hold the matching
      permission. ForegroundServiceTypes.HOST_SUPPORTED is the code-side mirror of this
      list; a type present in one and absent from the other is a bug that surfaces as an
      unexplainable crash inside the virtual app.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Runtime permissions a virtual app may request. UNIQUE can only ever narrow
         these: it cannot grant a virtual app something the user has not granted UNIQUE. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Package visibility.

      Add App lists the user's installed applications, which Android 11+ hides behind
      QUERY_ALL_PACKAGES. This is a Play-policy-sensitive permission and is declared
      deliberately: without it the Installed tab can only show apps with a launcher
      intent, which silently omits exactly the apps a user is most likely to want.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Custom Tabs, which is the most reliable Google OAuth path (Mode C). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.unique.app.UniqueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unique"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false">

        <activity
            android:name="com.unique.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Unique.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required from Android 14 whenever the SPECIAL_USE foreground service type
             is used, and it must sit inside <application>. -->
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Hosting a virtualized application's foreground service" />

        <!-- Flutter's own metadata; the UI lives in the :core process only. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The one component of UNIQUE that every other process of UNIQUE can reach.
             It answers "which :vappN slot serves this guest authority", which only the
             main process can know: it holds the instance table and the process pool.
             Not exported - nothing outside UNIQUE has any business asking. -->
        <provider
            android:name="com.unique.app.runtime.UniqueRouterProvider"
            android:authorities="${applicationId}.router"
            android:exported="false"
            android:grantUriPermissions="false" />

        <!-- Asks the device whether a WebView can render, in a process of its own so a
             Chromium renderer crash cannot take anything else down. Used by the
             acceptance suite to tell a device failure from a UNIQUE failure. -->
        <service
            android:name="com.unique.app.runtime.WebViewProbeService"
            android:process=":webviewprobe"
            android:exported="false" />

        <!-- The authority UNIQUE lends to guests so a virtual app can share a file with
             a real one. Not exported: nothing may open it by knowing its name, only by
             being handed a URI, and that handing is the platform's own temporary grant. -->
        <provider
            android:name="com.unique.app.runtime.UniqueSharedProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The VirtualCore server. Single writer for the state database. -->
        <service
            android:name="com.unique.app.server.UniqueServerService"
            android:process=":server"
            android:exported="false" />

<!-- GENERATED_STUBS -->

    </application>
</manifest>
