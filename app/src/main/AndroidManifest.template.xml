<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for UNIQUE's host manifest.

  The stub component pool is injected at the GENERATED_STUBS marker by
  :app:generateStubs. Edit this file, never build/generated/unique/manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact alarms.

      A virtual app's alarm is scheduled by UNIQUE, so the host's permission is what the
      platform checks. SCHEDULE_EXACT_ALARM is user-grantable ("Alarms & reminders") and
      is the one an ordinary app would hold; USE_EXACT_ALARM is deliberately not declared,
      because it is reserved for alarm-clock and calendar apps and Play requires a policy
      declaration for it.

      When the user revokes it, a guest asking for an exact alarm gets the same
      SecurityException it would get on a device where its own permission was revoked.
      That is faithful, and UNIQUE reports it rather than silently downgrading the alarm
      to inexact - an alarm that fires ten minutes late is worse than one that visibly
      fails.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Foreground service types.

      A virtual app's foreground service runs on one of UNIQUE's stub services, so the
      host must declare every type it is willing to forward and hold the matching
      permission. ForegroundServiceTypes.HOST_SUPPORTED is the code-side mirror of this
      list; a type present in one and absent from the other is a bug that surfaces as an
      unexplainable crash inside the virtual app.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Install-time permissions a virtual app may need.

      UNIQUE can only ever narrow: a permission the host does not declare can never reach
      a guest, whatever the guest's own manifest asks for. So the host has to declare the
      superset - but a superset chosen from evidence, not "everything there is".

      This list is what 59 real applications actually declare, measured with
      `tools/apk-survey`, minus the ones below that a blanket declaration would not help
      with anyway. Install-time permissions cost nothing at runtime: the platform grants
      them at install and no dialog exists for them, which is exactly why a guest denied
      one has no way to recover.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!--
      Legacy external storage, capped at the API where it still meant anything.

      19 of 59 surveyed apps declare WRITE_EXTERNAL_STORAGE and 17 READ_EXTERNAL_STORAGE,
      almost all with `maxSdkVersion`. Declaring them unbounded on Android 13+ would show
      the user a storage prompt that grants nothing, because scoped storage replaced them
      with the READ_MEDIA_* family already declared below. The cap is what an ordinary app
      does and what keeps the permission screen honest.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Runtime permissions a virtual app may request. UNIQUE can only ever narrow
         these: it cannot grant a virtual app something the user has not granted UNIQUE.
         Declaring one does *not* grant it - the user is still asked, once, for UNIQUE. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!--
      All-files access, and the argument that used to be here against it.

      It used to say: "a guest's external storage is redirected into its own instance
      directory, so the device's real storage is not what it is reading." Every word of
      that is true about the *guest*, and it answers the wrong question. UNIQUE itself
      has to read the device's real storage exactly once per import, because that is
      where the assets a game already downloaded are:

        /storage/emulated/0/Android/obb/com.axlebolt.standoff2/*.obb

      Redirecting the guest at an empty directory and then having no way to fill it is
      what "the game does not see its OBB" was, and no amount of correct redirection
      fixes it. Since Android 11 that directory is guarded, and this is the permission
      the guard asks for.

      Declaring it grants nothing on its own — this is *special access*, and the user
      must turn it on from a Settings screen, which `SpecialAccess.ALL_FILES` opens.
      Everything degrades without it: `GuestAssetImport` reports SOURCE_UNREADABLE and
      the user can still hand UNIQUE the .obb file directly.

      maxSdkVersion is deliberately absent: this permission exists from API 30 on and is
      the only route on every release UNIQUE supports.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      Deliberately NOT declared, and why - because "declare everything" is the obvious
      answer and it is wrong in four different ways.

      WRITE_SETTINGS (2/59 surveyed apps): special access, and nothing UNIQUE needs. A
      guest changing the device's brightness or ringtone would be changing the *device's*,
      which is the one thing instance isolation is for.

      Usage access (PACKAGE_USAGE_STATS) is left out for a different reason — it would
      hand every guest the *host's* usage history, which is the isolation the rest of the
      engine exists to keep.

      REQUEST_INSTALL_PACKAGES, REQUEST_DELETE_PACKAGES: UNIQUE never installs or removes
      a package on the device - importing an APK is a file copy into its own storage. A
      guest that wants to install something is doing a thing UNIQUE does not do, and
      holding the permission would not change that.

      SMS, CALL_LOG and CALL_PHONE: no surveyed app needed them, they are the most
      sensitive groups Android has, and a virtualization tool asking for SMS access is a
      thing a user is right to refuse. Left out until an app that needs them is named.

      AUTHENTICATE_ACCOUNTS, GET_TASKS and friends: deprecated or signature-level. The
      platform ignores them.
    -->

    <!--
      Package visibility.

      Add App lists the user's installed applications, which Android 11+ hides behind
      QUERY_ALL_PACKAGES. This is a Play-policy-sensitive permission and is declared
      deliberately: without it the Installed tab can only show apps with a launcher
      intent, which silently omits exactly the apps a user is most likely to want.
    -->
    <!--
      Special access, declared so it can be *offered*.

      SYSTEM_ALERT_WINDOW grants nothing by being declared — the user turns it on in a
      Settings screen — but without the declaration that screen does not list UNIQUE at
      all, and `Settings.canDrawOverlays` can never become true. A guest asking to draw
      over other apps was refused three times in one phone log with nothing shown to the
      person holding it. App Details lists it now, says it belongs to UNIQUE and applies
      to every copy, and opens the screen. See `SpecialAccess`.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Permissions defined by Google's own packages, which a guest cannot hold on its behalf.

      A permission is checked against the *calling uid*, and inside UNIQUE every call is
      UNIQUE's. So a guest that declares one and UNIQUE that does not is a guest that is
      refused, with an error naming a service it can see:

        SecurityException: Not allowed to bind to service
            Intent { act=com.android.vending.licensing.ILicensingService pkg=com.android.vending }
          at ContextImpl.bindServiceCommon
          at com.pairip.licensecheck.LicenseClient.bindToLicensingService
        I System.exit called, status: 0                        <- the app killed itself

      That is Play's licence check, which every application Google re-signs with PAIRIP
      performs at startup and treats a bind failure as tampering. `CHECK_LICENSE` is the
      permission its service is guarded by; it is normal-level, so declaring it grants it
      at install with no dialog.

      READ_GSERVICES was observed being refused in the same log
      (`PERMISSION_CHECK permission=com.google.android.providers.gsf.permission.READ_GSERVICES
      result=DENIED`), and the install-referrer bind is what every attribution SDK does on
      first run.
    -->
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />
    <uses-permission android:name="com.google.android.providers.gsf.permission.READ_GSERVICES" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Custom Tabs, which is the most reliable Google OAuth path (Mode C). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!--
          Explicit as well as covered by QUERY_ALL_PACKAGES.

          The permission above is Play-policy-sensitive and may one day have to go; these
          three are the packages a guest genuinely needs to see, and naming them means
          losing the blanket permission costs the Add-App list its completeness and
          nothing else. A guest binding to Play's licensing or install-referrer service
          needs the package to be *visible* as well as permitted.
        -->
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="com.android.vending.licensing.ILicensingService" />
        </intent>
        <intent>
            <action android:name="com.android.vending.billing.InAppBillingService.BIND" />
        </intent>
        <intent>
            <action android:name="com.google.android.finsky.BIND_GET_INSTALL_REFERRER_SERVICE" />
        </intent>
        <!-- A guest sharing a file, opening a link or picking an image resolves through
             UNIQUE's own package manager; without these the chooser comes back empty. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="com.unique.app.UniqueApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unique"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="false">

        <activity
            android:name="com.unique.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Unique.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required from Android 14 whenever the SPECIAL_USE foreground service type
             is used, and it must sit inside <application>. -->
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Hosting a virtualized application's foreground service" />

        <!-- Flutter's own metadata; the UI lives in the :core process only. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The one component of UNIQUE that every other process of UNIQUE can reach.
             It answers "which :vappN slot serves this guest authority", which only the
             main process can know: it holds the instance table and the process pool.
             Not exported - nothing outside UNIQUE has any business asking. -->
        <provider
            android:name="com.unique.app.runtime.UniqueRouterProvider"
            android:authorities="${applicationId}.router"
            android:exported="false"
            android:grantUriPermissions="false" />

        <!-- Asks the device whether a WebView can render, in a process of its own so a
             Chromium renderer crash cannot take anything else down. Used by the
             acceptance suite to tell a device failure from a UNIQUE failure. -->
        <service
            android:name="com.unique.app.runtime.WebViewProbeService"
            android:process=":webviewprobe"
            android:exported="false" />

        <!-- The authority UNIQUE lends to guests so a virtual app can share a file with
             a real one. Not exported: nothing may open it by knowing its name, only by
             being handed a URI, and that handing is the platform's own temporary grant. -->
        <provider
            android:name="com.unique.app.runtime.UniqueSharedProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Where a guest's broadcast PendingIntent actually lands.
             In UNIQUE's main process, and that is the whole point: a PendingIntent fires
             long after the process that built it, so the component it names has to be one
             that exists whether or not any :vappN is running. The guest's own receiver
             class travels as an extra and the cold-broadcast router wakes it.
             Not exported: only UNIQUE's own PendingIntents point here. -->
        <receiver
            android:name="com.unique.app.runtime.BroadcastStub"
            android:exported="false" />

        <!-- The VirtualCore server. Single writer for the state database. -->
        <service
            android:name="com.unique.app.server.UniqueServerService"
            android:process=":server"
            android:exported="false" />

<!-- GENERATED_STUBS -->

    </application>
</manifest>
